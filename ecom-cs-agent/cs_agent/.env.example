# ============================================================
# 环境变量样例 —— 复制为 .env 后按需填写
#
#   cp .env.example .env
#
# ⚠️ 默认值刻意全部指向「离线模式」：不填任何密钥也能把
#    quickstart.py 跑通。只有你确实要接真实模型/真实业务系统时，
#    才需要往下填。
# ============================================================

# ---------- 大模型 ----------
# offline = 内置离线合成器（默认，零配置零费用，不联网）
# live    = 走真实模型，需要下面四项都填
LLM_MODE=offline
MODEL_PROVIDER=
MODEL_NAME=
BASE_URL=
API_KEY=

# ---------- 业务系统集成 ----------
# mock = 读 data/seed/*.json（默认，不联网）
# http = 调真实业务系统
INTEGRATION_MODE=mock

# ---------- 工具网关 ----------
# direct = 节点内直接调端口实现（默认）
# mcp    = 经 MCP stdio 网关调用，用于演示工具解耦
TOOL_GATEWAY=direct

# ---------- 检索（RAG）----------
# 纯 Python 字符 n-gram 检索是默认实现，无需任何依赖
# milvus = 切换到向量库，需要额外安装 pymilvus
VECTOR_STORE=memory
RAG_CONFIDENCE_THRESHOLD=0.35

# ---------- 企业微信（仅在 INTEGRATION_MODE=http 时需要）----------
WXWORK_CORP_ID=
WXWORK_APP_ID=
WXWORK_APP_SECRET=

# ---------- 可观测 ----------
LOG_LEVEL=INFO
LANGFUSE_ENABLED=false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# ---------- 演示用身份（离线 demo 使用的虚构数据）----------
DEMO_USER_ID=CS001
DEMO_USER_EXTERNAL_ID=wx_ext_001
DEMO_USER_PASSWORD=

# ---------- 业务系统地址（仅在 INTEGRATION_MODE=http 时需要）----------
# 适配器只做「发请求 + 把错误翻成 IntegrationError」，字段映射统一由
# integrations/normalize.py 负责，两条路径共用同一套归一规则
OMS_BASE_URL=
OMS_TOKEN=
LOGISTICS_BASE_URL=
LOGISTICS_KEY=
WMS_BASE_URL=
WMS_TOKEN=
HTTP_TIMEOUT_SECONDS=3

# ---------- 演示开关（离线 mock 专用）----------
# 每次业务调用前睡这么久，用来让 SSE 进度肉眼可见
MOCK_LATENCY_MS=0
# 逗号分隔，命中就抛异常，用来演示「部分失败不整体失败」的降级：
#   MOCK_FAIL_ACTIONS=logistics   python quickstart.py -s order
MOCK_FAIL_ACTIONS=
# 固定「今天」，让周报的周期与同环比可复现（不填则用系统日期）
CS_REPORT_TODAY=

# ---------- 服务模式（langgraph dev / webapp）----------
# 坐席令牌的签名密钥，工作台登录与平台鉴权（auth/auth.py）共用这一把。
# 不填也能跑：进程启动时随机生成一把，但**重启即失效**；
# 平台与 webapp 分开成两个进程时更必须显式配置，否则两边密钥不同、互不认账。
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
GRAPH_ID=cs

# ---------- 容器（可选）----------
IMAGE_NAME=
DOCKER_VOLUME_DIRECTORY=
