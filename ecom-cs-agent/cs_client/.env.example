# 客户端 SDK 与端到端脚本的配置。复制成 .env 后填写。
#
# ⚠️ 这一套脚本连的是 LangGraph 平台服务（不是离线 quickstart），
#    先起平台：在 cs_agent 目录下执行 ./run_cs_agent。
#    灌演示数据另见 store_client/cs_demo_init.py。

CS_SERVER_URL=http://127.0.0.1:2024

# 换令牌用的账号，POST {CS_SERVER_URL}/cs/get_token 校验的就是这一对。
# ⚠️ 必须与 cs_agent 的 DEMO_USER_ID / DEMO_USER_PASSWORD 一致。
CS_USER_ID=CS001
CS_USER_PASSWORD=
