# Config for the client SDK and end-to-end scripts. Copy to .env and fill in.
#
# NOTE: these scripts talk to the LangGraph platform service (not the offline quickstart),
# so start the platform first: ./run_cs_agent in cs_agent/.
# To seed demo data, see store_client/cs_demo_init.py.

CS_SERVER_URL=http://127.0.0.1:2024

# Credentials for exchanging a token: POST {CS_SERVER_URL}/cs/get_token verifies this pair.
# Must match cs_agent's DEMO_USER_ID / DEMO_USER_PASSWORD.
CS_USER_ID=CS001
CS_USER_PASSWORD=
