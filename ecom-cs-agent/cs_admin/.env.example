# 客服运营后台的配置。复制成 .env 后填写。
#
# ⚠️ 这个后台自己不存数据：所有页面都经 LangGraph 平台的 Store 读取，
#    所以必须先起平台服务 —— 在 cs_agent 目录下执行 ./run_cs_agent。
#    只想看效果的话不用跑它：根目录 `python quickstart.py` 离线就能跑通全部链路。

# ---------- 平台服务 ----------
CS_SERVER_URL=http://127.0.0.1:2024

# 换令牌用的账号：后台会拿它 POST {CS_SERVER_URL}/cs/get_token。
# ⚠️ 这两个值必须与 cs_agent 的 DEMO_USER_ID / DEMO_USER_PASSWORD 一致，
#    因为 /cs/get_token 校验的就是那一对；不一致的表现是后台登录不上、
#    或者每个页面都提示「获取token失败」。
CS_USER_ID=CS001
CS_PASSWORD=

# ---------- 后台自己的登录账号（与平台账号是两套）----------
ADMIN_USER_ID=admin
ADMIN_PASSWORD=

# Flask session 的签名密钥。不填则每次启动随机生成一把 —— 能跑，
# 但重启后需要重新登录；部署时必须显式配一个固定值。
FLASK_SECRET_KEY=
FLASK_DEBUG=False
