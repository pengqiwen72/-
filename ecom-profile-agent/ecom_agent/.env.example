# 复制本文件为 .env 并填入真实值（本文件不含任何密钥）
# ========= 大模型配置（核心，不配模型无法生成画像/标签/话术）=========
MODEL_PROVIDER=openai
# 使用的模型名，示例：qwen3.8-flash（阿里百炼）/ deepseek-chat（DeepSeek）
MODEL_NAME=qwen3.8-flash
# 模型服务商的 API Key（必填）
API_KEY=sk-xxxx
# OpenAI 兼容接口地址，示例：https://dashscope.aliyuncs.com/compatible-mode/v1
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ========= 演示坐席账号（智能体平台上的用户）=========
DEMO_USER_TOKEN=
DEMO_USER_ID=THOR
DEMO_USER_PASSWORD=your_password
DEMO_USER_EXTERNAL_ID=wmXXXXXXXXXXXXXXXXXX

# ========= 企业微信通知（可选，不配不影响核心功能）=========
WXWORK_CORP_ID=
WXWORK_APP_ID=
WXWORK_APP_SECRET=

# ========= 可观测性（可选）=========
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ecom-profile-agent
LOG_LEVEL=INFO

# ========= 部署相关（本地开发不用改）=========
IMAGE_NAME=
DOCKER_VOLUME_DIRECTORY=
