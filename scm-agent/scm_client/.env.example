# Config for the client SDK and end-to-end scripts. Copy to .env and fill in.
#
# NOTE: these scripts talk to the LangGraph platform service (not the offline quickstart),
# so start the platform first: ./run_scm_agent in scm_agent/.
# To seed demo data, see store_client/scm_demo_init.py.

SCM_SERVER_URL=http://127.0.0.1:2024

# Credentials for exchanging a token: POST {SCM_SERVER_URL}/scm/get_token verifies this pair.
# Must match scm_agent's DEMO_USER_ID / DEMO_USER_PASSWORD.
SCM_USER_ID=CS001
SCM_USER_PASSWORD=
