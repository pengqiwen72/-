# Config for the CS operations admin. Copy to .env and fill in.
#
# NOTE: this admin stores nothing itself -- every page reads through the LangGraph
# platform Store, so the platform must be running first: ./run_scm_agent in scm_agent/.
# Just want to see it work? Skip this: `python quickstart.py` at the repo root runs offline.

# ---------- Platform service ----------
SCM_SERVER_URL=http://127.0.0.1:2024

# Credentials for exchanging a token: the admin POSTs them to {SCM_SERVER_URL}/scm/get_token.
# These two MUST match scm_agent's DEMO_USER_ID / DEMO_USER_PASSWORD,
# since that pair is exactly what /scm/get_token verifies. If they differ you cannot
# log in, or every page reports "failed to get token".
SCM_USER_ID=CS001
SCM_PASSWORD=

# ---------- The admin's own login (separate from the platform account) ----------
ADMIN_USER_ID=admin
ADMIN_PASSWORD=

# Flask session signing key. Empty = a random key each start: it runs, but you must
# log in again after every restart; deployments must set a fixed value.
FLASK_SECRET_KEY=
FLASK_DEBUG=False
