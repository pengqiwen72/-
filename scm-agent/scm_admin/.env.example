# Config for the SCM approval dashboard. Copy to .env and fill in.
#
# NOTE: this dashboard stores nothing itself -- it reads approval records through the
# LangGraph platform Store, so the platform must be running first: ./run_scm_agent in scm_agent/.
# Just want to see the agent work? Skip this: `python quickstart.py` at the repo root runs offline.

# ---------- Platform service ----------
SCM_SERVER_URL=http://127.0.0.1:2024

# Credentials for exchanging a token: the dashboard POSTs them to {SCM_SERVER_URL}/scm/get_token.
# These two MUST match scm_agent's DEMO_USER_ID / DEMO_USER_PASSWORD,
# since that pair is exactly what /scm/get_token verifies. If they differ you cannot
# get a token, and the page will say so instead of rendering an empty table.
SCM_USER_ID=OP001
SCM_PASSWORD=

# Dashboard port (default 5000).
SCM_ADMIN_PORT=5000
