# ============================================================
# Example environment file -- copy to .env and fill in as needed.
#
#   cp .env.example .env
#
# Every default below deliberately points at "offline mode": quickstart.py runs
# end to end without filling in a single secret. Only fill something in when you
# actually want a real model or a real business system.
# ============================================================

# ---------- LLM ----------
# offline = built-in offline synthesizer (default: no config, no cost, no network)
# live    = real model; requires all four values below
LLM_MODE=offline
MODEL_PROVIDER=
MODEL_NAME=
BASE_URL=
API_KEY=

# ---------- Business system integration ----------
# mock = read data/seed/*.json (default, offline)
# http = call the real business systems
INTEGRATION_MODE=mock

# ---------- Tool gateway ----------
# direct = call the port implementation in-process (default)
# mcp    = go through the MCP stdio gateway; demonstrates tool decoupling
TOOL_GATEWAY=direct

# ---------- Retrieval (RAG) ----------
# Pure-Python character n-gram retrieval is the default; no extra dependency.
# milvus = switch to a vector store; requires installing pymilvus
VECTOR_STORE=memory
RAG_CONFIDENCE_THRESHOLD=0.35

# ---------- WeCom / WeChat Work (only needed when INTEGRATION_MODE=http) ----------
WXWORK_CORP_ID=
WXWORK_APP_ID=
WXWORK_APP_SECRET=

# ---------- Observability ----------
LOG_LEVEL=INFO
LANGFUSE_ENABLED=false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# ---------- Demo identity (fictional data used by the offline demo) ----------
DEMO_USER_ID=CS001
DEMO_USER_EXTERNAL_ID=wx_ext_001
DEMO_USER_PASSWORD=

# ---------- Business system endpoints (needed only when INTEGRATION_MODE=http) ----------
# Adapters only issue the request and translate errors into IntegrationError;
# field mapping is centralized in integrations/normalize.py, shared by both paths.
OMS_BASE_URL=
OMS_TOKEN=
LOGISTICS_BASE_URL=
LOGISTICS_KEY=
WMS_BASE_URL=
WMS_TOKEN=
HTTP_TIMEOUT_SECONDS=3

# ---------- Demo switches (offline mock only) ----------
# Sleep this long before each business call so SSE progress is visible to the eye
MOCK_LATENCY_MS=0
# Comma-separated; a hit raises, demonstrating "partial failure, not total failure":
#   MOCK_FAIL_ACTIONS=logistics   python quickstart.py -s order
MOCK_FAIL_ACTIONS=
# Pin "today" so the report period and WoW/MoM numbers stay reproducible (empty = system date)
SCM_REPORT_TODAY=

# ---------- Service mode (langgraph dev / webapp) ----------
# Signing key for agent tokens, shared by the workbench login and platform auth
# (auth/auth.py). Empty works -- a random key is generated at process start -- but it is
# lost on restart. With platform and webapp as two processes you MUST set it explicitly,
# otherwise the two sides sign with different keys and reject each other's tokens.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
GRAPH_ID=scm

# ---------- Containers (optional) ----------
IMAGE_NAME=
DOCKER_VOLUME_DIRECTORY=
