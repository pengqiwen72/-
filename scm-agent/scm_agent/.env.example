# ============================================================
# Example environment file -- copy to .env and fill in as needed.
#
#   cp .env.example .env
#
# Every default below deliberately points at "offline mode": quickstart.py runs
# end to end without filling in a single secret. Only fill something in when you
# actually want a real model or a real business system.
# ============================================================

# ---------- LLM ----------
# offline = built-in offline synthesizer (default: no config, no cost, no network)
# live    = real model; requires all four values below
LLM_MODE=offline
MODEL_PROVIDER=
MODEL_NAME=
BASE_URL=
API_KEY=

# ---------- Business system integration ----------
# mock = read data/seed/*.json (default, offline)
# http = call the real business systems
INTEGRATION_MODE=mock

# ---------- Tool gateway ----------
# direct = call the port implementation in-process (default)
# mcp    = go through the MCP stdio gateway; demonstrates tool decoupling
TOOL_GATEWAY=direct

# ---------- Retrieval (RAG) ----------
# Pure-Python character n-gram retrieval is the default; no extra dependency.
# milvus = switch to a vector store; requires installing pymilvus
VECTOR_STORE=memory
# Below this fused confidence the answer subgraph hands off to a human instead of
# forcing an answer (recalibrated for the SCM corpus; see tests/test_rag_confidence.py)
RAG_CONFIDENCE_THRESHOLD=0.30

# ---------- Knowledge graph ----------
# memory = in-process graph projected from data/seed/*.json (default, zero config)
# neo4j  = real graph database; requires installing neo4j and filling NEO4J_URI below
GRAPH_STORE=memory
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# ---------- Observability ----------
LOG_LEVEL=INFO
LANGFUSE_ENABLED=false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# ---------- Demo identity (fictional data used by the offline demo) ----------
# Operators live in data/seed/operators.json: OP001 buyer / OP002 manager /
# OP003 inspector / OP004 warehouse keeper
DEMO_USER_ID=OP001
DEMO_USER_EXTERNAL_ID=
DEMO_USER_PASSWORD=

# ---------- Business system endpoints (needed only when INTEGRATION_MODE=http) ----------
# One pair per upstream system: ERP (materials/purchase orders), SRM (suppliers/quotes),
# WMS (warehouses/stock/receipts), TICKET (human hand-off tickets), OSS (report objects).
# Adapters only issue the request and translate errors into IntegrationError;
# field mapping is centralized in integrations/normalize.py, shared by both paths.
ERP_BASE_URL=
ERP_TOKEN=
SRM_BASE_URL=
SRM_TOKEN=
WMS_BASE_URL=
WMS_TOKEN=
TICKET_BASE_URL=
TICKET_TOKEN=
OSS_BASE_URL=
OSS_TOKEN=
HTTP_TIMEOUT_SECONDS=3

# ---------- Resilience ----------
# Circuit breaker on business ports / the graph channel / HTTP hosts: after N
# consecutive failures the dependency is cut off (fast-fail, no more timeouts)
# for RESET seconds, then a single probe is let through. See integrations/resilience.py.
BREAKER_FAIL_THRESHOLD=3
BREAKER_RESET_SECONDS=20

# ---------- Demo switches (offline mock only) ----------
# Sleep this long before each business call so SSE progress is visible to the eye
MOCK_LATENCY_MS=0
# Comma-separated; a hit raises, demonstrating "partial failure, not total failure":
#   MOCK_FAIL_ACTIONS=material   python quickstart.py -s load_degraded
#   MOCK_FAIL_ACTIONS=graph      python quickstart.py -s qa_degraded
MOCK_FAIL_ACTIONS=
# Where mock file objects (quality reports) land on disk and what fake URL
# prefix they get back. Empty = data/runtime/objects and oss://scm-demo.
MOCK_OBJECT_DIR=
MOCK_OBJECT_BASE=

# ---------- Service mode (langgraph dev / webapp) ----------
# Signing key for agent tokens, shared by the workbench login and platform auth
# (auth/auth.py). Empty works -- a random key is generated at process start -- but it is
# lost on restart. With platform and webapp as two processes you MUST set it explicitly,
# otherwise the two sides sign with different keys and reject each other's tokens.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
GRAPH_ID=scm

# ---------- Containers (optional) ----------
IMAGE_NAME=
DOCKER_VOLUME_DIRECTORY=
